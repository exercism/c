#include "test-framework/unity.h"
#include "{{ header }}"
#include <stdint.h>

void setUp(void)
{
}

void tearDown(void)
{
}

static void assert_protein_match(protein_t expected, protein_t actual)
{
   TEST_ASSERT_EQUAL_CHAR(expected.valid, actual.valid);
   if (expected.valid) {
      TEST_ASSERT_EQUAL_size_t(expected.count, actual.count);
      if (expected.count > 0) {
         TEST_ASSERT_EQUAL_INT_ARRAY(expected.amino_acids, actual.amino_acids,
                                     expected.count);
      }
   }
}

{%- for case in cases %}

static void {{ case.test_function }}(void)
{
{%- if loop.index == 2 %}
   TEST_IGNORE();   // delete this line to run test
{%- elif not loop.first %}
   TEST_IGNORE();
{%- endif %}
{%- if not case.expect_error %}
   protein_t expected = {
      .valid = true,
      .count = {{ case.expected | length }},
{%- if case.expected %}
      .amino_acids = { {{ case.expected | join(", ") }} },
{%- endif %}
   };
{%- else %}
   protein_t expected = {
      .valid = false,
   };
{% endif %}
   protein_t actual = protein({{ case.given | quote }});
   assert_protein_match(expected, actual);
}
{%- endfor %}

int main(void)
{
   UNITY_BEGIN();

{% for case in cases %}
   RUN_TEST({{ case.test_function }});
{%- endfor %}

   return UNITY_END();
}
