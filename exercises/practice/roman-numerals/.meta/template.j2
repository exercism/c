{%- elif not loop.first %}
   TEST_IGNORE();
{%- endif %}
   check_conversion({{ case.given }}, {{ case.expected | quote }});
}
{%- endfor %}

int main(void)
{
   UNITY_BEGIN();

{% for case in cases %}
   RUN_TEST({{ case.test_function }});
{%- endfor %}

   return UNITY_END();
}
