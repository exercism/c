#include "test-framework/unity.h"
#include "{{ header }}"

void setUp(void)
{
}

void tearDown(void)
{
}
{% for case in cases %}

static void {{ case.test_function }}(void)
{
{%- if loop.index == 2 %}
   TEST_IGNORE();   // delete this line to run test
{%- elif not loop.first %}
   TEST_IGNORE();
{%- endif %}
   const dice_t dice = { {{ case.input.dice | quote }} };
   TEST_ASSERT_EQUAL_INT({{ case.expected }}, score(dice, {{ case.input.category | replace(" ", "_") |upper }}));
}
{%- endfor %}

int main(void)
{
   UNITY_BEGIN();

{% for case in cases %}
   RUN_TEST({{ case.test_function }});
{%- endfor %}

   return UNITY_END();
}
