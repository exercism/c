{% macro construct_date(datestring) %}
   {%- set datestring = datestring + "T00:00:00" -%}
   {%- set yyyy = datestring.split("T")[0].split("-")[0] -%}
   {%- set month = datestring.split("T")[0].split("-")[1] -%}
   {%- set day = datestring.split("T")[0].split("-")[2] -%}
   {%- set hour = datestring.split("T")[1].split(":")[0] -%}
   {%- set min = datestring.split("T")[1].split(":")[1] -%}
   {%- set sec = datestring.split("T")[1].split(":")[2] -%}
   construct_date({{ yyyy }}, {{ month | int }}, {{ day| int }}, {{ hour | int }}, {{ min | int }}, {{ sec | int }})
{%- endmacro %}

#include "test-framework/unity.h"
#include "{{ header }}"

#define BUFFER_SIZE sizeof("YYYY-mm-dd HH:MM:SS")

static inline size_t is_leap_year(int year)
{
   if (year % 400 == 0)
      return 1;
   if (year % 100 == 0)
      return 0;
   if (year % 4 == 0)
      return 1;
   return 0;
}

static inline time_t days_from_1ad(int year)
{
   --year;   // The gregorian calendar is without a year 0. This is years from
             // 1AD.
   // Little complex, add a day for all of the leap years
   // This is a quarter of the days since 0 except one in a hundred are lost
   // except 1 in 400 are gained ... simple.
   return 365 * year + (year / 400) - (year / 100) + (year / 4);
}

static time_t construct_date(int year, int month, int day, int hour, int min,
                             int sec)
{
   static const time_t seconds_in_day = 86400;   // 60 * 60 * 24
   static const time_t days[2][12] = {
      { 0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334 },
      { 0, 31, 60, 91, 121, 152, 182, 213, 244, 274, 305, 335 }
   };

   time_t days_since_epoch = (days_from_1ad(year) - days_from_1ad(1970)) +
                             days[is_leap_year(year)][(month - 1)] + (day - 1);
   time_t result =
       (seconds_in_day * days_since_epoch) + (60 * ((hour * 60) + min) + sec);

   return result;
}

void setUp(void)
{
}

void tearDown(void)
{
}

{%- for case in cases %}

static void {{ case.test_function }}(void)
{
{%- if loop.index == 2 %}
   TEST_IGNORE();   // delete this line to run test
{%- elif not loop.first %}
   TEST_IGNORE();
{%- endif %}
   time_t before = {{ construct_date(case.given) }};
   char after[BUFFER_SIZE] = { 0 };
   gigasecond(before, after, BUFFER_SIZE);
   TEST_ASSERT_EQUAL_STRING({{ case.expected | replace("T", " ") | quote }}, after);
}
{%- endfor %}

int main(void)
{
   UNITY_BEGIN();

{% for case in cases %}
   RUN_TEST({{ case.test_function }});
{%- endfor %}

   return UNITY_END();
}
